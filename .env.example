# WeeFee — copy to .env and fill in. NEVER commit .env.

# ── Stripe ───────────────────────────────────────────────────────────────────
# Start with TEST keys (sk_test_...). Only switch to live once Phase 1 passes.
# In production use a RESTRICTED key, not the account secret key:
#   Checkout Sessions: write · PaymentIntents: read · Charges: read · Refunds: write
#   everything else: none
STRIPE_SECRET_KEY=sk_test_replace_me

# From `stripe listen` locally, or the Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── This service ─────────────────────────────────────────────────────────────
# Public HTTPS URL of the portal. Stripe redirects guests back here, so it must
# be reachable from the public internet — i.e. NOT the campground (CGNAT).
WEEFEE_BASE_URL=http://localhost:8000

# Shared secret the on-site gateway agent presents. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEEFEE_GATEWAY_TOKEN=replace_me

# ── Brand ────────────────────────────────────────────────────────────────────
WEEFEE_BRAND=WeeFee
WEEFEE_TAGLINE="Brought to you by Fuq Ice"
WEEFEE_INSTAGRAM=fuqiceoffical
WEEFEE_SUPPORT="the camp office"

# ── Grace lease ──────────────────────────────────────────────────────────────
# Tiny metered lease granted when a guest taps Buy, so Stripe Checkout and any
# 3DS bank redirect can load before they have paid. You cannot allowlist every
# card issuer's domain, so this exists instead.
WEEFEE_GRACE_MINUTES=10
WEEFEE_GRACE_MB=25
WEEFEE_GRACE_KBPS=1000
WEEFEE_GRACE_COOLDOWN=60
